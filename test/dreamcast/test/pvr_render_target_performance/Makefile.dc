# Performance comparison: native Dreamcast PVR renderer with ordered
# render targets.
#
# Ordered render targets are always enabled. Create target textures before
# beginning the frame's drawing scene.
#
# Single ELF built against the standard SDL2 archive.

TARGET = pvr_render_target_performance
TARGET_SRC = pvr_render_target_performance.c

# ------------------------------------------------------------------
# Archive paths
# ------------------------------------------------------------------
SDL2_ROOT ?= $(abspath ../../../..)
SDL2_LIBDIR ?= $(SDL2_ROOT)/build-scripts/dcbuild
SDL2_INCLUDEDIR ?= $(SDL2_LIBDIR)/include/SDL2
SDL2_CONFIG_INCLUDEDIR ?= $(SDL2_LIBDIR)/include-config-/SDL2

# ------------------------------------------------------------------
# Screenshot support
# ------------------------------------------------------------------
HARDWARE_SCREENSHOTS ?= 0
SCREENSHOT_CFLAGS =
ifeq ($(HARDWARE_SCREENSHOTS),1)
SCREENSHOT_CFLAGS += -DDC_PVR_RENDER_TARGET_PERFORMANCE_HARDWARE_SCREENSHOT
endif

# ------------------------------------------------------------------
# Common flags
# ------------------------------------------------------------------
COMMON_CFLAGS = -I$(SDL2_CONFIG_INCLUDEDIR) -I$(SDL2_INCLUDEDIR) \
		-DDREAMCAST -D__DREAMCAST__ \
		-Wall -Wextra -Werror

all: check-sdl2 $(TARGET).elf $(TARGET).bin

# ------------------------------------------------------------------
# Build
# ------------------------------------------------------------------
$(TARGET_SRC:.c=.o): $(TARGET_SRC)
	kos-cc $(COMMON_CFLAGS) $(SCREENSHOT_CFLAGS) -c $< -o $@

$(TARGET).elf: $(TARGET_SRC:.c=.o)
	kos-cc -o $@ $(TARGET_SRC:.c=.o) -Wl,-Map,$(TARGET).map \
		$(SDL2_LIBDIR)/libSDL2.a \
		$(SDL2_LIBDIR)/libSDL2main.a \
		-lGL -lm -lkosutils -lpthread

$(TARGET).bin: $(TARGET).elf
	$(KOS_OBJCOPY) -O binary $(TARGET).elf $(TARGET).bin

# ------------------------------------------------------------------
# Linker-map symbol check
# ------------------------------------------------------------------
.PHONY: check-sdl2
check-sdl2:
	@test -f $(SDL2_LIBDIR)/libSDL2.a || \
		(echo "SDL2 archive not found in $(SDL2_LIBDIR)"; exit 1)
	@sh-elf-nm $(SDL2_LIBDIR)/libSDL2.a | grep -q '[[:space:]]_DC_RenderDriver$$' || \
		(echo "Native Dreamcast PVR renderer missing from archive"; exit 1)
	@sh-elf-nm $(SDL2_LIBDIR)/libSDL2.a | grep -q '[[:space:]]_DC_PVR_PrepareRenderTarget$$' || \
		(echo "Ordered render-target preparation hook missing from archive"; exit 1)

# ------------------------------------------------------------------
# Hardware launch
# ------------------------------------------------------------------
.PHONY: run
run: $(TARGET).bin
	@echo "Upload and run: $(TARGET).elf"
	@echo "  kos-tool -t <DC_IP> -x $(TARGET).elf -m ."

# ------------------------------------------------------------------
# Clean
# ------------------------------------------------------------------
.PHONY: clean
clean:
	rm -f $(TARGET_SRC:.c=.o) $(TARGET).elf $(TARGET).bin $(TARGET).map
