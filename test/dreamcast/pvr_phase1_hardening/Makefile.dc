	kos-cc -o $@ $< $(SDL3_LIBRARY) -lGL -lm -lpthread -lsh4zam

$(TARGET)_p1c_diag3_control.elf: $(TARGET)_p1c_diag3_control.o
	kos-cc -o $@ $< $(SDL3_LIBRARY) -lGL -lm -lpthread -lsh4zam

$(TARGET)_p1c_diag3_pressure.elf: $(TARGET)_p1c_diag3_pressure.o
	kos-cc -o $@ $< $(SDL3_LIBRARY) -lGL -lm -lpthread -lsh4zam

$(TARGET)_p1c_repeat_control.elf: $(TARGET)_p1c_repeat_control.o
	kos-cc -o $@ $< $(SDL3_LIBRARY) -lGL -lm -lpthread -lsh4zam

$(TARGET)_p1c_repeat_pressure_1.elf: $(TARGET)_p1c_repeat_pressure_1.o
	kos-cc -o $@ $< $(SDL3_LIBRARY) -lGL -lm -lpthread -lsh4zam

$(TARGET)_p1c_repeat_pressure_2.elf: $(TARGET)_p1c_repeat_pressure_2.o
	kos-cc -o $@ $< $(SDL3_LIBRARY) -lGL -lm -lpthread -lsh4zam

$(TARGET)_p1c_repeat_pressure_3.elf: $(TARGET)_p1c_repeat_pressure_3.o
	kos-cc -o $@ $< $(SDL3_LIBRARY) -lGL -lm -lpthread -lsh4zam

$(TARGET)_p1a.bin: $(TARGET)_p1a.elf
	$(KOS_OBJCOPY) -O binary $< $@

$(TARGET)_p1b.bin: $(TARGET)_p1b.elf
	$(KOS_OBJCOPY) -O binary $< $@

$(TARGET)_p1c.bin: $(TARGET)_p1c.elf
	$(KOS_OBJCOPY) -O binary $< $@

$(TARGET)_p1c_control.bin: $(TARGET)_p1c_control.elf
	$(KOS_OBJCOPY) -O binary $< $@


$(TARGET)_p1c_pressure_2.bin: $(TARGET)_p1c_pressure_2.elf
	$(KOS_OBJCOPY) -O binary $< $@

$(TARGET)_p1c_pressure_3.bin: $(TARGET)_p1c_pressure_3.elf
	$(KOS_OBJCOPY) -O binary $< $@

$(TARGET)_p1c_diag2_control.bin: $(TARGET)_p1c_diag2_control.elf
	$(KOS_OBJCOPY) -O binary $< $@

$(TARGET)_p1c_diag2_pressure.bin: $(TARGET)_p1c_diag2_pressure.elf
	$(KOS_OBJCOPY) -O binary $< $@

$(TARGET)_p1c_diag3_control.bin: $(TARGET)_p1c_diag3_control.elf
	$(KOS_OBJCOPY) -O binary $< $@

$(TARGET)_p1c_diag3_pressure.bin: $(TARGET)_p1c_diag3_pressure.elf
	$(KOS_OBJCOPY) -O binary $< $@

$(TARGET)_p1c_repeat_control.bin: $(TARGET)_p1c_repeat_control.elf
